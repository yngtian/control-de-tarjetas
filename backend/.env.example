# Copia este archivo como .env y completa los valores.

# Puerto de la API
PORT=3000

# Firebase Realtime Database. Si faltan estas dos variables, los datos se
# guardan en el archivo local datos-local.json (solo para desarrollo).
# URL de la base: Consola de Firebase > Realtime Database (ej: https://mi-proyecto-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=
# Ruta al JSON de la cuenta de servicio: Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
FIREBASE_CREDENCIALES=./firebase-credenciales.json

# Secreto para firmar las sesiones (una cadena larga y aleatoria). Si cambia, todos
# deben volver a ingresar. Sin ella, en desarrollo se genera una en .secreto-sesion.
SESSION_SECRET=

# Cuenta demo (correo "demo", contraseña "123") para mostrar la app sin registrarse.
# Cualquiera puede usarla: poner CUENTA_DEMO=no antes de publicar.
CUENTA_DEMO=si
